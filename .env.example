# BookLoop environment variables — docs/TECH.md §4
# Copy to .env.local (Next.js) or .env (scripts) and fill in. Never commit.

# ---------- Required ----------

# Neon Postgres (Neon dashboard → Connect → pooled connection string)
DATABASE_URL=

# Better Auth — generate secrets with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Extra trusted origins for the web app (comma-separated). BETTER_AUTH_URL is
# always trusted; add preview/staging hosts here.
# APP_ORIGINS=https://staging.example.com

# Public URL used for metadata, OG images, sitemap and robots.
# NEXT_PUBLIC_APP_URL=https://bookloop.example.com

# Optional support inbox shown on /privacy and /terms. Without it, the pages
# point students at the in-app "Report a problem" link instead.
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com

# Turn Better Auth's per-IP rate limits off (local QA stacks only).
# AUTH_RATE_LIMIT=off

# socket.io chat token signing. Must match in the web app and realtime server.
# Generate: openssl rand -base64 32
CHAT_JWT_SECRET=

# ---------- Optional: realtime chat ----------

# Direct (unpooled) Neon URL for the realtime Postgres listener. Falls back to
# DATABASE_URL when omitted.
# DATABASE_URL_UNPOOLED=

# External realtime host override. Leave empty on Vercel (same-origin function)
# and for plain `next dev` (REST polling fallback). Set to http://localhost:4001
# when running `npm run realtime` or the Docker realtime profile.
# NEXT_PUBLIC_REALTIME_URL=

# Local realtime server port (default 4001)
# REALTIME_PORT=4001

# ---------- Optional: integrations & admin ----------

# UploadThing (book photos). Optional: without it, uploads use the built-in
# /api/photos → sharp → Postgres path. Set PHOTO_DAILY_LIMIT to change the
# per-student daily upload cap (default 40); QA stacks raise it.
UPLOADTHING_TOKEN=

# Comma-separated emails allowed into /admin/stats
# ADMIN_EMAILS=you@example.com

# Where "Report a problem" heads-up mail is sent (optional)
# TEAM_INBOX_EMAIL=

# Email provider — FULL LAUNCH ONLY (testing mode uses the console stub, D-059)
# RESEND_API_KEY=

# ---------- Optional: scripts ----------

# Set to "yes" to allow `npm run db:seed` against a production-looking database
# SEED_PROD_OK=
