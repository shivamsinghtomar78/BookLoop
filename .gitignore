# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# local agent settings & generated skills
.claude/
.qoder/

# playwright mcp artifacts
.playwright-mcp/
responsive-*.png
screenshots/

# Local InstaCloud state (credentials, linked control plane, hooks) — per machine
.insta/

# InstaCloud: agent skills installed by `npx skills add` (regenerable, not source)
.claude/skills/
.agents/skills/
.github/skills/
skills-lock.json

# QA artifacts (screenshots, axe, lighthouse, traces)
/artifacts/
/test-results/
/playwright-report/

# Codex/agent local hook state
/.codex/

# Generated image staging
/vibe_images/
